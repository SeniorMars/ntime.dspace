import NtimeDspace.SumProduct.Machine
import Complexity.Computability.Complexity.Classes.Hierarchy.Space
import Complexity.Computability.Machines.Turing.MultiTape.Complexity.LogSpace.CounterProgram

/-!
# Sum–product recursions generated by a finite-control state machine

A *generator* describes a sum–product recursion by numeric functions of a state: the kind,
precision and parameter of the node of a state, the bits of a leaf value, and the state of a
child (`GenFun`). Its unfolding from an initial state, with a fuel bounding the depth, is an
`SPTree` (`GenFun.tree`). The node at a path is the unfolding at the state reached by applying
the child function along the path (`node_tree`), so explicit queries need only fold the child
function over the path: no recursion is needed to describe deep nodes.

This is how the formula of §6.2 and the routines of its explicit machine (Lemma 6.4) are described:
a state records the routine and its arguments; a node never needs the context above it.
-/

namespace NtimeDspace.SumProduct

open SPTree

/-- The numeric data of a generator, at a fixed input. -/
structure GenFun where
  tag : ℕ → ℕ
  prec : ℕ → ℕ
  param : ℕ → ℕ
  bit : ℕ → ℕ → Bool
  child : ℕ → ℕ → ℕ

namespace GenFun

variable (g : GenFun)

/-- The value of a leaf with given bits. -/
def leafValue (st : ℕ) : ℕ := ∑ k ∈ Finset.range (g.prec st), (g.bit st k).toNat * 2 ^ k

/-- The unfolding of a generator from a state, with fuel. -/
def tree : ℕ → ℕ → SPTree
  | 0, _ => .leaf 0 0
  | n + 1, st =>
    if g.tag st = 1 then .sum (g.prec st) (g.param st) fun i => tree n (g.child st i)
    else if g.tag st = 2 then .prod (g.prec st) (tree n (g.child st 0)) (tree n (g.child st 1))
    else if g.tag st = 3 then .shift (g.prec st) (g.param st) (tree n (g.child st 0))
    else .leaf (g.prec st) (g.leafValue st)

/-- The state at a path, deepest symbol first. -/
def stateAt (st : ℕ) : List ℕ → ℕ
  | [] => st
  | i :: π => g.child (stateAt st π) i

/-- The reported kind: `0` for anything that is not a sum, product or shift. -/
def tagN (st : ℕ) : ℕ := if g.tag st = 1 ∨ g.tag st = 2 ∨ g.tag st = 3 then g.tag st else 0

/-- The reported parameter: the index length of a sum, the shift of a shift node, else `0`. -/
def paramN (st : ℕ) : ℕ := if g.tag st = 1 ∨ g.tag st = 3 then g.param st else 0

theorem child_tree_succ (n st i : ℕ) (h : (g.tree (n + 1) st).ValidChild i) :
    (g.tree (n + 1) st).child i = g.tree n (g.child st i) := by
  simp only [tree] at h ⊢
  split_ifs at h ⊢ with h1 h2 h3
  · rfl
  · simp only [ValidChild] at h
    simp only [SPTree.child]
    split_ifs with hi
    · subst hi; rfl
    · rw [show i = 1 by omega]
  · simp only [ValidChild] at h; subst h; rfl
  · exact h.elim

/-- **The node at a path** is the unfolding at the state of the path, with the fuel reduced. -/
theorem node_tree (n st : ℕ) : ∀ π : List ℕ, Valid (g.tree n st) π →
    π.length ≤ n ∧ node (g.tree n st) π = g.tree (n - π.length) (g.stateAt st π)
  | [], _ => by simp [stateAt]
  | i :: π, ⟨hπ, hi⟩ => by
    obtain ⟨hlen, hnode⟩ := node_tree n st π hπ
    rw [hnode] at hi
    -- A node with a valid child has fuel left.
    obtain ⟨m, hm⟩ : ∃ m, n - π.length = m + 1 := by
      rcases h0 : n - π.length with _ | m
      · rw [h0] at hi; exact absurd hi (by simp [tree, ValidChild])
      · exact ⟨m, rfl⟩
    rw [hm] at hi
    refine ⟨by simp; omega, ?_⟩
    rw [node_cons, hnode, hm, child_tree_succ g m _ i hi]
    simp only [List.length_cons, stateAt]
    congr 1
    omega

theorem sum_bits_lt (b : ℕ → Bool) : ∀ P, ∑ j ∈ Finset.range P, (b j).toNat * 2 ^ j < 2 ^ P
  | 0 => by simp
  | P + 1 => by
    rw [Finset.sum_range_succ, pow_succ]
    have h1 := sum_bits_lt b P
    have h2 : (b P).toNat * 2 ^ P ≤ 2 ^ P := by
      have : (b P).toNat ≤ 1 := Bool.toNat_le _
      calc (b P).toNat * 2 ^ P ≤ 1 * 2 ^ P := Nat.mul_le_mul_right _ this
        _ = 2 ^ P := one_mul _
    omega

theorem testBit_sum_bits (b : ℕ → Bool) : ∀ P k, k < P →
    (∑ j ∈ Finset.range P, (b j).toNat * 2 ^ j).testBit k = b k
  | 0, k, h => absurd h (by omega)
  | P + 1, k, h => by
    rw [Finset.sum_range_succ, Nat.add_comm, Nat.mul_comm,
      Nat.testBit_two_pow_mul_add _ (sum_bits_lt b P)]
    rcases Nat.lt_or_ge k P with hk | hk
    · rw [if_pos hk]; exact testBit_sum_bits b P k hk
    · have hk' : k = P := by omega
      subst hk'
      rw [if_neg (lt_irrefl k), Nat.sub_self]
      cases b k <;> simp

theorem testBit_leafValue (st k : ℕ) (hk : k < g.prec st) :
    (g.leafValue st).testBit k = g.bit st k :=
  testBit_sum_bits (g.bit st) _ k hk

theorem leafValue_lt (st : ℕ) : g.leafValue st < 2 ^ g.prec st := sum_bits_lt _ _

/-- The oracles of the unfolding with fuel `H`: deep nodes past the fuel are leaves `0`. -/
def genQ (H st₀ : ℕ) (π : List ℕ) : Info :=
  if π.length < H then
    ⟨g.tagN (g.stateAt st₀ π), g.prec (g.stateAt st₀ π), g.paramN (g.stateAt st₀ π)⟩
  else ⟨0, 0, 0⟩

/-- The leaf-bit oracle of the unfolding. -/
def genLB (st₀ : ℕ) (π : List ℕ) (k : ℕ) : Bool := g.bit (g.stateAt st₀ π) k

theorem info_tree_succ (m st : ℕ) :
    (g.tree (m + 1) st).info = ⟨g.tagN st, g.prec st, g.paramN st⟩ := by
  simp only [tree, tagN, paramN]
  split_ifs <;> simp_all [SPTree.info, SPTree.tag, SPTree.prec, SPTree.param]

/-- **The generic oracles agree with the unfolding.** -/
theorem agrees_tree (H st₀ : ℕ) :
    Agrees (g.genQ H st₀) (g.genLB st₀) (g.tree H st₀) [] := by
  intro ρ hρ
  rw [List.append_nil]
  obtain ⟨hlen, hnode⟩ := g.node_tree H st₀ ρ hρ
  rw [hnode]
  rcases Nat.lt_or_ge ρ.length H with hlt | hge
  · obtain ⟨m, hm⟩ : ∃ m, H - ρ.length = m + 1 := ⟨H - ρ.length - 1, by omega⟩
    rw [hm]
    refine ⟨by rw [genQ, if_pos hlt, info_tree_succ], fun k ht hk => ?_⟩
    simp only [tree] at ht hk ⊢
    split_ifs at ht hk ⊢ <;> simp_all [SPTree.tag, SPTree.prec, SPTree.value, genLB,
      Nat.mod_eq_of_lt (g.leafValue_lt _), g.testBit_leafValue _ _ hk]
  · have : H - ρ.length = 0 := by omega
    rw [this]
    refine ⟨by rw [genQ, if_neg (by omega)]; rfl, fun k _ hk => ?_⟩
    simp [tree, SPTree.prec] at hk

end GenFun

end NtimeDspace.SumProduct
