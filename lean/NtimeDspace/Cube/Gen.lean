import NtimeDspace.SumProduct.Gen

-- upstream: local-only (the walks-on-the-cube route of `separating-ntime-from-space.tex`, §3 and §6.2)

/-!
# Formulas generated by structured states

An `AGen St` describes a formula over `ℤ` (Definition 3.1) by its states: the kind of the node of a
state (a sum node of index length `width st`, a binary product, or a leaf with an integer value) and
the state of each child. Its unfolding `AGen.tree P n st` (with fuel `n`) is the `SPTree` of
residues modulo `2^P` evaluated by Proposition 3.2 (`SumProduct.Eval`); negative leaves become
their least nonnegative residues.

* `AGen.Sound mean rank`: the *meaning* `mean st ∈ ℤ` of every state satisfies the equation of its
  node (a sum over the children, a product of the two children, or the leaf value), and the rank
  decreases from a node to its children. Then `tree_value`: the unfolded tree has value
  `mean st mod 2^P`, given fuel above the rank.
* `AGen.Budgeted ℓ bud`: a budget that pays for the cost of every node (`w + ℓ` at a sum node,
  `ℓ` at a product). Then `tree_cost_le`: the cost of the tree is at most the budget of the root.

This is how the formula of §6.2 is proved to have value `Z(G)` (by the merge, the codes and the
transport recursion, one state at a time) and cost `O(F)` (Lemma 6.3).
-/

namespace NtimeDspace.Cube

open NtimeDspace.SumProduct Finset

/-- The kinds of nodes. -/
inductive Kind | leaf | sum | prod
  deriving DecidableEq

/-- A formula over `ℤ` described by structured states. -/
structure AGen (St : Type) where
  kind : St → Kind
  width : St → ℕ
  leafVal : St → ℤ
  child : St → ℕ → St

namespace AGen

variable {St : Type} (g : AGen St)

/-- The residue of an integer modulo `2^P`, as a natural number. -/
def res (P : ℕ) (v : ℤ) : ℕ := (v % (2 ^ P : ℤ)).toNat

/-- The unfolded tree, with fuel. -/
def tree (P : ℕ) : ℕ → St → SPTree
  | 0, _ => .leaf 0 0
  | n + 1, st =>
    match g.kind st with
    | .sum => .sum P (g.width st) fun i => tree P n (g.child st i)
    | .prod => .prod P (tree P n (g.child st 0)) (tree P n (g.child st 1))
    | .leaf => .leaf P (res P (g.leafVal st))

/-- **Local soundness** of a meaning on the states of an invariant closed under children, with a
rank that decreases from a node to its children. -/
structure Sound (inv : St → Prop) (mean : St → ℤ) (rank : St → ℕ) : Prop where
  sum : ∀ st, inv st → g.kind st = .sum →
    mean st = ∑ i ∈ range (2 ^ g.width st), mean (g.child st i) ∧
    ∀ i < 2 ^ g.width st, inv (g.child st i) ∧ rank (g.child st i) < rank st
  prod : ∀ st, inv st → g.kind st = .prod →
    mean st = mean (g.child st 0) * mean (g.child st 1) ∧
    inv (g.child st 0) ∧ inv (g.child st 1) ∧
    rank (g.child st 0) < rank st ∧ rank (g.child st 1) < rank st
  leaf : ∀ st, inv st → g.kind st = .leaf → mean st = g.leafVal st

/-- **The value of the unfolded tree** is the meaning of the state modulo `2^P`. -/
theorem tree_value {inv : St → Prop} {mean : St → ℤ} {rank : St → ℕ}
    (h : g.Sound inv mean rank) (P : ℕ) :
    ∀ n st, inv st → rank st < n → (g.tree P n st).value = res P (mean st) := by
  intro n
  induction n with
  | zero => intro st _ hst; omega
  | succ n ih =>
    intro st hinv hst
    have hP : (0 : ℤ) < 2 ^ P := by positivity
    have key : ∀ x : ℤ, ((res P x : ℕ) : ℤ) = x % 2 ^ P := fun x => by
      unfold res; exact Int.toNat_of_nonneg (Int.emod_nonneg _ hP.ne')
    suffices H : (((g.tree P (n + 1) st).value : ℕ) : ℤ) = mean st % 2 ^ P by
      have := key (mean st); exact_mod_cast H.trans this.symm
    rcases hk : g.kind st with _ | _ | _
    · simp only [tree, hk, SPTree.value]
      rw [h.leaf st hinv hk]
      push_cast
      rw [key, Int.emod_emod_of_dvd _ (dvd_refl _)]
    · obtain ⟨hm, hr⟩ := h.sum st hinv hk
      simp only [tree, hk, SPTree.value]
      push_cast
      have hc : ∀ i ∈ range (2 ^ g.width st),
          (((tree g P n (g.child st i)).value : ℕ) : ℤ) = mean (g.child st i) % 2 ^ P := by
        intro i hi
        rw [ih _ (hr i (Finset.mem_range.mp hi)).1
          (by have := (hr i (Finset.mem_range.mp hi)).2; omega), key]
      rw [Finset.sum_congr rfl hc, hm, Finset.sum_int_mod]
      simp only [Int.emod_emod_of_dvd _ (dvd_refl _)]
      rw [← Finset.sum_int_mod]
    · obtain ⟨hm, hi0, hi1, hr0, hr1⟩ := h.prod st hinv hk
      simp only [tree, hk, SPTree.value]
      push_cast
      rw [ih _ hi0 (by omega), ih _ hi1 (by omega), key, key, hm, ← Int.mul_emod]

/-- **A budget** paying for every node on the states of an invariant closed under children:
`w + ℓ` at a sum node of index length `w`, `ℓ` at a product node. -/
structure Budgeted (inv : St → Prop) (ℓ : ℕ) (bud : St → ℕ) : Prop where
  sum : ∀ st, inv st → g.kind st = .sum → ∀ i < 2 ^ g.width st,
    inv (g.child st i) ∧ bud (g.child st i) + g.width st + ℓ ≤ bud st
  prod : ∀ st, inv st → g.kind st = .prod →
    inv (g.child st 0) ∧ inv (g.child st 1) ∧
    bud (g.child st 0) + ℓ ≤ bud st ∧ bud (g.child st 1) + ℓ ≤ bud st

/-- **The cost of the unfolded tree** is at most the budget of the root. -/
theorem tree_cost_le {inv : St → Prop} {ℓ : ℕ} {bud : St → ℕ} (h : g.Budgeted inv ℓ bud) (P : ℕ) :
    ∀ n st, inv st → (g.tree P n st).cost ℓ ≤ bud st := by
  intro n
  induction n with
  | zero => intro st _; simp [tree, SPTree.cost]
  | succ n ih =>
    intro st hinv
    rcases hk : g.kind st with _ | _ | _
    · simp [tree, hk, SPTree.cost]
    · simp only [tree, hk, SPTree.cost]
      have : ((range (2 ^ g.width st)).sup fun i => (tree g P n (g.child st i)).cost ℓ) ≤
          bud st - g.width st - ℓ := by
        refine Finset.sup_le fun i hi => ?_
        have h1 := h.sum st hinv hk i (Finset.mem_range.mp hi)
        have := ih (g.child st i) h1.1
        omega
      have h0 : 2 ^ g.width st ≠ 0 := by positivity
      have := (h.sum st hinv hk 0 (Nat.pos_of_ne_zero h0)).2
      omega
    · simp only [tree, hk, SPTree.cost]
      obtain ⟨hi0, hi1, h0, h1⟩ := h.prod st hinv hk
      have := ih (g.child st 0) hi0; have := ih (g.child st 1) hi1
      omega

/-! ### Numeric generators -/

/-- The tag of a kind for `SumProduct.GenFun`: `1` sum, `2` product, `0` leaf. -/
def kindTag : Kind → ℕ
  | .leaf => 0
  | .sum => 1
  | .prod => 2

/-- **A numeric generator agrees with `g`** under an encoding `e` of the states of an invariant
closed under children, at precision `P`. -/
structure Agrees (gn : GenFun) (e : St → ℕ) (inv : St → Prop) (P : ℕ) : Prop where
  closed_sum : ∀ st, inv st → g.kind st = .sum → ∀ i < 2 ^ g.width st, inv (g.child st i)
  closed_prod : ∀ st, inv st → g.kind st = .prod → inv (g.child st 0) ∧ inv (g.child st 1)
  tag : ∀ st, inv st → gn.tag (e st) = kindTag (g.kind st)
  prec : ∀ st, inv st → gn.prec (e st) = P
  param : ∀ st, inv st → g.kind st = .sum → gn.param (e st) = g.width st
  bit : ∀ st, inv st → g.kind st = .leaf → ∀ k < P, gn.bit (e st) k = (res P (g.leafVal st)).testBit k
  child : ∀ st, inv st → ∀ i, gn.child (e st) i = e (g.child st i)

theorem leafValue_eq {gn : GenFun} {e : St → ℕ} {inv : St → Prop} {P : ℕ} (h : g.Agrees gn e inv P)
    {st : St} (hinv : inv st) (hk : g.kind st = .leaf) :
    gn.leafValue (e st) = res P (g.leafVal st) := by
  apply Nat.eq_of_testBit_eq
  intro k
  have hlt : res P (g.leafVal st) < 2 ^ P := by
    unfold res
    have hP : (0 : ℤ) < 2 ^ P := by positivity
    have h1 := Int.emod_lt_of_pos (g.leafVal st) hP
    have h0 := Int.emod_nonneg (g.leafVal st) hP.ne'
    have e : (((g.leafVal st % 2 ^ P).toNat : ℕ) : ℤ) = g.leafVal st % 2 ^ P := Int.toNat_of_nonneg h0
    have : (((g.leafVal st % 2 ^ P).toNat : ℕ) : ℤ) < ((2 ^ P : ℕ) : ℤ) := by push_cast; omega
    exact_mod_cast this
  rcases Nat.lt_or_ge k P with hkP | hkP
  · rw [GenFun.testBit_leafValue _ _ _ (by rw [h.prec st hinv]; exact hkP), h.bit st hinv hk k hkP]
  · rw [Nat.testBit_eq_false_of_lt (lt_of_lt_of_le (GenFun.leafValue_lt _ _)
        (Nat.pow_le_pow_right (by norm_num) (by rw [h.prec st hinv]; exact hkP))),
      Nat.testBit_eq_false_of_lt (lt_of_lt_of_le hlt (Nat.pow_le_pow_right (by norm_num) hkP))]

/-- **The numeric unfolding has the value of the unfolding of `g`.** -/
theorem value_agrees {gn : GenFun} {e : St → ℕ} {inv : St → Prop} {P : ℕ} (h : g.Agrees gn e inv P) :
    ∀ n st, inv st → (gn.tree n (e st)).value = (g.tree P n st).value := by
  intro n
  induction n with
  | zero => intro st _; rfl
  | succ n ih =>
    intro st hinv
    have ht := h.tag st hinv
    rcases hk : g.kind st with _ | _ | _
    · rw [hk] at ht; simp only [kindTag] at ht
      simp only [GenFun.tree, tree, hk, ht, h.prec st hinv, show ¬ (0 = 1) by omega,
        show ¬ (0 = 2) by omega, show ¬ (0 = 3) by omega, ite_false, SPTree.value]
      rw [leafValue_eq g h hinv hk]
    · rw [hk] at ht; simp only [kindTag] at ht
      simp only [GenFun.tree, tree, hk, ht, ite_true, h.prec st hinv, h.param st hinv hk, SPTree.value]
      congr 1
      refine Finset.sum_congr rfl fun i hi => ?_
      rw [h.child st hinv i]
      exact ih _ (h.closed_sum st hinv hk i (Finset.mem_range.mp hi))
    · rw [hk] at ht; simp only [kindTag] at ht
      simp only [GenFun.tree, tree, hk, ht, show ¬ (2 = 1) by omega, ite_false, ite_true,
        h.prec st hinv, SPTree.value]
      obtain ⟨h0, h1⟩ := h.closed_prod st hinv hk
      rw [h.child st hinv 0, h.child st hinv 1, ih _ h0, ih _ h1]

/-- **The numeric unfolding has the cost of the unfolding of `g`.** -/
theorem cost_agrees {gn : GenFun} {e : St → ℕ} {inv : St → Prop} {P : ℕ} (h : g.Agrees gn e inv P)
    (ℓ : ℕ) : ∀ n st, inv st → (gn.tree n (e st)).cost ℓ = (g.tree P n st).cost ℓ := by
  intro n
  induction n with
  | zero => intro st _; rfl
  | succ n ih =>
    intro st hinv
    have ht := h.tag st hinv
    rcases hk : g.kind st with _ | _ | _
    · rw [hk] at ht; simp only [kindTag] at ht
      simp only [GenFun.tree, tree, hk, ht, show ¬ (0 = 1) by omega,
        show ¬ (0 = 2) by omega, show ¬ (0 = 3) by omega, ite_false, SPTree.cost]
    · rw [hk] at ht; simp only [kindTag] at ht
      simp only [GenFun.tree, tree, hk, ht, ite_true, h.param st hinv hk, SPTree.cost]
      congr 1
      refine Finset.sup_congr rfl fun i hi => ?_
      rw [h.child st hinv i]
      exact ih _ (h.closed_sum st hinv hk i (Finset.mem_range.mp hi))
    · rw [hk] at ht; simp only [kindTag] at ht
      simp only [GenFun.tree, tree, hk, ht, show ¬ (2 = 1) by omega, ite_false, ite_true, SPTree.cost]
      obtain ⟨h0, h1⟩ := h.closed_prod st hinv hk
      rw [h.child st hinv 0, h.child st hinv 1, ih _ h0, ih _ h1]

end AGen

end NtimeDspace.Cube
